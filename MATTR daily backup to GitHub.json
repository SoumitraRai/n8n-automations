    {
      "parameters": {
        "jsCode": "// Is the workflow new on GitHub, changed, or the same? Same files are skipped,\n// so a night with no edits makes no commits.\nconst file = $('Format file').first().json;\nconst got = $input.first().json;\nlet status = 'new';\nif (got && got.sha) {\n  // GitHub only returns the content of files under 1 MB; bigger ones count as changed.\n  const old = got.content ? Buffer.from(got.content, 'base64').toString('utf8') : null;\n  status = old === file.content ? 'same' : 'changed';\n}\nreturn [{ json: { ...file, status } }];\n"
      },
      "id": "6c6ada45-88d3-4763-b32f-cd51644f9743",
      "name": "Compare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
